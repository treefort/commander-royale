# /etc/commander-royale.env — settings for commander-royale.service (chmod 600: it can hold secrets).
# Every variable is described in examples/README.md. This one is for a server behind a proxy that signs people in
# and passes their user name on (the Caddyfile example).
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://game.example.com
AUTH=header
AUTH_HEADER=X-Remote-User
DB_PATH=/var/lib/commander-royale/xcom.sqlite
GAME_DIR=/opt/commander-royale/gamedata
# ADMINS=header:alice
# PLUGINS=plugins/allowlist.ts
# ALLOWLIST=header:alice,header:bob
